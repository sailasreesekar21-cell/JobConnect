# Copy this file to .env and fill in your own local values.
# Never commit a real .env file.

PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local MongoDB example:
# MONGODB_URI=mongodb://127.0.0.1:27017/jobconnect
# MongoDB Atlas example (replace with your own cluster details):
# MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/jobconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jobconnect

# Long random string used to sign login tokens. Generate your own.
# Example: in PowerShell: [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional: used only by npm run create-admin
ADMIN_NAME=Project Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: used only by npm run seed to create a clearly labelled demo recruiter
DEMO_SEED_PASSWORD=replace-with-a-demo-password
